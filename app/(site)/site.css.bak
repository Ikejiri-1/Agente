/* ============ Site público (landing futurista) ============ */
.nx-root {
  --c: #5fd3ff;
  --v: #8f7bff;
  --ink: #eaf8ff;
  --mute: #b4cfe2;
  --line: rgba(110, 220, 255, 0.5);
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: var(--ink);
  background:
    radial-gradient(ellipse 70% 50% at 50% 55%, rgba(20, 90, 200, 0.28), transparent 70%),
    radial-gradient(ellipse 50% 40% at 85% 10%, rgba(120, 80, 255, 0.16), transparent 70%),
    #020817;
  font-family: ui-sans-serif, system-ui, "Segoe UI", sans-serif;
}
.nx-root button { font: inherit; cursor: pointer; }
.nx-bg { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; }
.nx-root > *:not(.nx-bg) { position: relative; z-index: 1; }

/* navegação */
.nx-nav { display: flex; align-items: center; justify-content: space-between; padding: 18px clamp(16px, 4vw, 48px); transition: opacity 0.5s; }
.nx-nav nav { display: flex; align-items: center; gap: 22px; }
.nx-logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; font-size: 15px; }
.nx-logo-dot { width: 12px; height: 12px; border-radius: 50%; background: var(--c); box-shadow: 0 0 14px 3px rgba(95, 211, 255, 0.7); animation: nx-blink 2.4s ease-in-out infinite; }
.nx-link { background: none; border: 0; color: var(--ink); font-size: 15px; opacity: 0.9; text-decoration: none; }
.nx-link:hover { color: var(--c); }
.nx-btn { display: inline-flex; align-items: center; justify-content: center; padding: 10px 20px; border-radius: 10px; border: 1px solid var(--line); background: rgba(10, 40, 80, 0.55); color: var(--ink); font-size: 15px; font-weight: 600; text-decoration: none; transition: box-shadow 0.2s, background 0.2s, transform 0.2s; }
.nx-btn:hover:not(:disabled) { box-shadow: 0 0 22px rgba(95, 211, 255, 0.45); transform: translateY(-1px); }
.nx-btn-solid { background: linear-gradient(135deg, #1b8bff, #5fd3ff); color: #02101f; border-color: transparent; }
.nx-btn:disabled { opacity: 0.7; cursor: not-allowed; }
.nx-root :focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

/* hero */
.nx-hero { text-align: center; padding: 8px 20px 0; transition: opacity 0.5s; }
.nx-kicker { font-size: 13px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--c); margin: 0 0 10px; }
.nx-hero h1 { margin: 0; font-size: clamp(28px, 4vw, 52px); line-height: 1.1; font-weight: 800; }
.nx-hero h1 span { display: block; background: linear-gradient(90deg, #5fd3ff, #a99bff); -webkit-background-clip: text; background-clip: text; color: transparent; }
.nx-sub { max-width: 640px; margin: 14px auto 0; color: var(--mute); font-size: clamp(15px, 1.5vw, 18px); }
.nx-hero-cta { display: flex; gap: 12px; justify-content: center; margin-top: 20px; }

/* palco */
.nx-stage-wrap { position: relative; width: max(720px, min(100vw, calc((100vh - 300px) * 1.6))); margin: 8px auto 0; aspect-ratio: 16 / 10; }
.nx-stage { position: absolute; inset: 0; container-type: inline-size; transform-origin: 0 0; transition: transform 1.05s cubic-bezier(0.7, 0, 0.2, 1); }
.nx-links { position: absolute; inset: 0; width: 100%; height: 100%; }
.nx-link-line { stroke: rgba(95, 211, 255, 0.45); stroke-width: 0.25; stroke-dasharray: 1.2 1.6; animation: nx-flow 1.6s linear infinite; }
.nx-root:has(.nx-stage-wrap[data-zoom]) .nx-hero,
.nx-root:has(.nx-stage-wrap[data-zoom]) .nx-nav,
.nx-root:has(.nx-stage-wrap[data-zoom]) .nx-how { opacity: 0; pointer-events: none; }
.nx-stage:has(.is-zoomed) .nx-node:not(.is-zoomed),
.nx-stage:has(.is-zoomed) .nx-core,
.nx-stage:has(.is-zoomed) .nx-links { opacity: 0.1; transition: opacity 0.6s; }
.nx-stage-wrap[data-zoom]::after { content: ""; position: absolute; inset: -40%; pointer-events: none; background: radial-gradient(circle, rgba(140, 230, 255, 0.5), transparent 55%); opacity: 0; animation: nx-flash 1.05s ease-out; }

/* núcleo */
.nx-core { position: absolute; left: 50%; top: 50%; width: 26cqw; aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; display: grid; place-items: center; }
.nx-core::before { content: ""; position: absolute; inset: -18%; border-radius: 50%; background: radial-gradient(circle, rgba(60, 150, 255, 0.35), transparent 65%); animation: nx-breathe 4s ease-in-out infinite; }
.nx-core-body { position: relative; width: 100%; aspect-ratio: 1; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 18%; background: radial-gradient(circle at 35% 30%, #8fe3ff 0, #2a7bff 28%, #0a2a7a 62%, #031033 100%); box-shadow: 0 0 60px rgba(60, 160, 255, 0.6), inset 0 0 50px rgba(160, 230, 255, 0.35); }
.nx-core-body strong { font-size: max(15px, 2.1cqw); letter-spacing: 0.06em; text-transform: uppercase; text-shadow: 0 1px 8px rgba(0, 10, 40, 0.8); }
.nx-core-body span { margin-top: 0.8cqw; font-size: max(11px, 1.1cqw); color: #dff6ff; text-shadow: 0 1px 6px rgba(0, 10, 40, 0.9); }
.nx-core-ring { position: absolute; inset: -9%; border-radius: 50%; border: 1px dashed rgba(120, 220, 255, 0.55); animation: nx-spin 28s linear infinite; }
.nx-core-ring-b { inset: -16%; border-style: dotted; border-color: rgba(160, 140, 255, 0.5); animation-duration: 40s; animation-direction: reverse; }

/* nódulos */
.nx-node { position: absolute; width: max(54px, 7cqw); aspect-ratio: 1; translate: -50% -50%; padding: 0; border: 0; background: none; color: var(--ink); }
.nx-node:hover, .nx-node:focus-visible { z-index: 20; }
.nx-node-orb { position: absolute; inset: 0; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--line); background: radial-gradient(circle at 35% 30%, rgba(80, 170, 255, 0.45), rgba(5, 20, 55, 0.9) 70%); box-shadow: 0 0 22px rgba(60, 160, 255, 0.4), inset 0 0 18px rgba(110, 220, 255, 0.25); transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s; }
.nx-node-orb::before { content: ""; position: absolute; inset: -8px; border-radius: 50%; border: 1px solid rgba(95, 211, 255, 0.5); opacity: 0; transform: scale(0.85); transition: 0.3s; }
.nx-node:hover .nx-node-orb, .nx-node:focus-visible .nx-node-orb { transform: scale(1.12); border-color: #fff; box-shadow: 0 0 36px rgba(95, 211, 255, 0.9), inset 0 0 22px rgba(160, 235, 255, 0.5); }
.nx-node:hover .nx-node-orb::before, .nx-node:focus-visible .nx-node-orb::before { opacity: 1; transform: scale(1); animation: nx-spin 6s linear infinite; border-style: dashed; }
.nx-node-label { position: absolute; top: calc(100% + 0.7cqw); left: 50%; translate: -50% 0; width: 15cqw; text-align: center; font-size: max(11px, 1.2cqw); font-weight: 600; line-height: 1.2; text-shadow: 0 1px 6px #000; }
.nx-node.is-zoomed .nx-node-orb { animation: nx-burst 1.2s ease-out 0.5s both; }

/* cartão de hover */
.nx-card { position: absolute; z-index: 5; width: 250px; display: flex; flex-direction: column; gap: 6px; text-align: left; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--line); background: linear-gradient(160deg, #08244c, #030c1e); box-shadow: 0 0 34px rgba(60, 160, 255, 0.35); opacity: 0; pointer-events: none; transition: opacity 0.22s, transform 0.22s; }
.nx-card b { font-size: 15px; }
.nx-card i { font-style: normal; font-size: 13px; color: var(--mute); }
.nx-card-list { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--ink); }
.nx-card-list span::before { content: "› "; color: var(--c); }
.nx-card em { font-style: normal; font-size: 12px; color: var(--c); margin-top: 2px; }
.nx-card::before { content: ""; position: absolute; inset: 0; border-radius: 12px; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(120, 220, 255, 0.05) 0 1px, transparent 1px 4px); }
.nx-node:hover .nx-card, .nx-node:focus-visible .nx-card { opacity: 1; }
.nx-tip-right .nx-card { left: calc(100% + 16px); top: 50%; transform: translate(-8px, -50%); }
.nx-tip-right:hover .nx-card, .nx-tip-right:focus-visible .nx-card { transform: translate(0, -50%); }
.nx-tip-left .nx-card { right: calc(100% + 16px); top: 50%; transform: translate(8px, -50%); }
.nx-tip-left:hover .nx-card, .nx-tip-left:focus-visible .nx-card { transform: translate(0, -50%); }
.nx-tip-bottom .nx-card { top: calc(100% + max(34px, 4cqw)); left: 50%; transform: translate(-50%, -8px); }
.nx-tip-bottom:hover .nx-card, .nx-tip-bottom:focus-visible .nx-card { transform: translate(-50%, 0); }
.nx-tip-top .nx-card { bottom: calc(100% + 16px); left: 50%; transform: translate(-50%, 8px); }
.nx-tip-top:hover .nx-card, .nx-tip-top:focus-visible .nx-card { transform: translate(-50%, 0); }
.nx-stage:has(.is-zoomed) .nx-card { display: none; }

/* chips */
.nx-chip { align-self: flex-start; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 9px; border-radius: 99px; color: #ffd37a; background: rgba(255, 200, 90, 0.12); border: 1px solid rgba(255, 200, 90, 0.5); }
.nx-chip-on { color: #7dffd6; background: rgba(60, 255, 190, 0.12); border-color: rgba(60, 255, 190, 0.5); }
.nx-ico { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; color: var(--c); background: rgba(40, 120, 220, 0.22); border: 1px solid var(--line); flex: none; }

/* holograma (base) */
.nx-holo { position: relative; overflow: hidden; border-radius: 16px; border: 1px solid var(--line); background: linear-gradient(160deg, rgba(10, 44, 90, 0.9), rgba(3, 12, 30, 0.97)); box-shadow: 0 0 40px rgba(50, 160, 255, 0.3), inset 0 0 50px rgba(80, 190, 255, 0.08); }
.nx-holo::before { content: ""; position: absolute; inset: 0; border-radius: 16px; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(120, 220, 255, 0.045) 0 1px, transparent 1px 4px); }
.nx-holo::after { content: ""; position: absolute; left: 0; right: 0; height: 40%; top: -40%; pointer-events: none; background: linear-gradient(180deg, transparent, rgba(140, 230, 255, 0.09), transparent); animation: nx-sheen 5s linear infinite; }

/* painel de detalhe */
.nx-root .nx-detail { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: 20px; background: radial-gradient(circle, rgba(2, 10, 30, 0.55), rgba(2, 8, 22, 0.88)); animation: nx-fade 0.5s both; overflow: auto; }
.nx-detail-card { display: grid; grid-template-columns: 1fr 1.3fr; gap: 24px; width: min(900px, 100%); padding: 28px; animation: nx-rise 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
.nx-detail-art { display: grid; place-items: center; border-radius: 12px; background: radial-gradient(circle, rgba(30, 110, 220, 0.25), rgba(2, 10, 30, 0.6)); border: 1px solid rgba(110, 220, 255, 0.25); }
.nx-detail-body { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 12px; }
.nx-detail-body h2 { margin: 0; font-size: clamp(24px, 3vw, 34px); }
.nx-detail-body p { margin: 0; color: var(--mute); font-size: 16px; line-height: 1.5; }
.nx-detail-body ul, .nx-plan ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; }
.nx-detail-body li, .nx-plan li { position: relative; padding-left: 22px; font-size: 15px; line-height: 1.4; }
.nx-detail-body li::before, .nx-plan li::before { content: ""; position: absolute; left: 2px; top: 0.5em; width: 8px; height: 8px; border-radius: 2px; background: var(--c); box-shadow: 0 0 8px var(--c); }
.nx-chip-row { display: flex; align-items: center; gap: 12px; }
.nx-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

/* cenas animadas */
.nx-scene { width: 100%; max-width: 340px; }
.nx-s-ring { fill: none; stroke: rgba(110, 220, 255, 0.4); stroke-width: 1; }
.nx-s-track { stroke-width: 10; stroke-linecap: round; stroke: rgba(110, 220, 255, 0.18); }
.nx-s-sweep path { fill: rgba(95, 220, 255, 0.3); }
.nx-s-sweep { transform-origin: 120px 80px; animation: nx-spin 3.2s linear infinite; }
.nx-s-blip { fill: #7dffd6; animation: nx-blink 1.6s ease-in-out infinite; }
.nx-s-bar { fill: rgba(95, 211, 255, 0.75); transform-box: fill-box; transform-origin: bottom; animation: nx-grow 1s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
.nx-s-best { fill: #7dffd6; filter: drop-shadow(0 0 8px #7dffd6); }
.nx-s-arc { fill: none; stroke: #5fd3ff; stroke-width: 10; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 100; animation: nx-arc 1.6s ease-out 0.3s forwards; filter: drop-shadow(0 0 6px #5fd3ff); }
.nx-s-needle path { stroke: #fff; stroke-width: 3; stroke-linecap: round; }
.nx-s-needle { transform-origin: 120px 120px; animation: nx-needle 1.6s ease-out 0.3s both; }
.nx-s-core { fill: #5fd3ff; filter: drop-shadow(0 0 12px #5fd3ff); }
.nx-s-pulse { fill: none; stroke: #5fd3ff; stroke-width: 1.5; transform-box: fill-box; transform-origin: center; animation: nx-ping 2.4s ease-out infinite; }

/* como funciona */
.nx-how { text-align: center; padding: 40px 20px 56px; transition: opacity 0.5s; }
.nx-how h2 { margin: 0 0 18px; font-size: 13px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--c); }
.nx-how ol { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 14px 18px; margin: 0; padding: 0; list-style: none; }
.nx-how li { display: flex; align-items: center; gap: 12px; font-weight: 600; }
.nx-arrow { color: var(--c); font-size: 22px; }
.nx-tagline { margin: 28px 0 6px; font-size: clamp(16px, 2vw, 22px); font-style: italic; }
.nx-fine { margin: 0; font-size: 13px; color: var(--mute); }

/* planos holográficos */
.nx-root .nx-plans { position: fixed; inset: 0; z-index: 60; overflow: auto; padding: 36px 20px 48px; display: flex; flex-direction: column; align-items: center; gap: 28px; background: radial-gradient(ellipse 80% 60% at 50% 60%, rgba(20, 80, 190, 0.35), transparent 70%), #020817; animation: nx-fade 0.45s both; }
.nx-plans::before { content: ""; position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(rgba(95, 211, 255, 0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(95, 211, 255, 0.07) 1px, transparent 1px); background-size: 48px 48px; mask-image: radial-gradient(ellipse at 50% 70%, #000, transparent 75%); }
.nx-plans-head { position: relative; text-align: center; }
.nx-plans-head h2 { margin: 0; font-size: clamp(24px, 3.4vw, 40px); }
.nx-plans-head p { margin: 8px 0 0; color: var(--mute); font-size: 15px; }
.nx-plans-grid { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 26px; width: min(1100px, 100%); }
.nx-plan { display: flex; flex-direction: column; animation: nx-materialize 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
.nx-plan-card { flex: 1; display: flex; flex-direction: column; gap: 14px; padding: 26px 24px; animation: nx-float 6s ease-in-out infinite; }
.nx-plan:nth-child(2) .nx-plan-card { animation-delay: -2s; }
.nx-plan:nth-child(3) .nx-plan-card { animation-delay: -4s; }
.nx-plan-hot .nx-plan-card { border-color: rgba(170, 150, 255, 0.8); box-shadow: 0 0 50px rgba(130, 100, 255, 0.4), inset 0 0 50px rgba(140, 120, 255, 0.1); }
.nx-plan-card > * { position: relative; z-index: 1; }
.nx-plan-card h3 { margin: 0; font-size: 24px; }
.nx-plan-blurb { margin: 0; color: var(--mute); font-size: 15px; }
.nx-plan-price { margin: 0; }
.nx-plan-price strong { font-size: 40px; line-height: 1; }
.nx-plan-price span { color: var(--mute); font-size: 14px; }
.nx-plan ul { flex: 1; }
.nx-plan-flag { align-self: flex-start; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 10px; border-radius: 99px; color: #d9d2ff; background: rgba(143, 123, 255, 0.2); border: 1px solid rgba(170, 150, 255, 0.7); }
.nx-beam { height: 54px; margin: 4px 6% 0; clip-path: polygon(0 0, 100% 0, 72% 100%, 28% 100%); background: linear-gradient(180deg, rgba(95, 211, 255, 0.4), transparent); animation: nx-fade 1.2s 0.5s both; }
.nx-plan-hot .nx-beam { background: linear-gradient(180deg, rgba(150, 125, 255, 0.45), transparent); }
.nx-plans-close { position: relative; }

/* mobile */
.nx-mobile-grid { display: none; list-style: none; margin: 18px 0 0; padding: 0 16px; gap: 12px; grid-template-columns: 1fr; }
.nx-mobile-card { display: flex; align-items: center; gap: 14px; width: 100%; padding: 14px 16px; text-align: left; color: var(--ink); }
.nx-mobile-card > * { position: relative; z-index: 1; }
.nx-mobile-card b { display: block; font-size: 16px; }
.nx-mobile-card i { font-style: normal; font-size: 14px; color: var(--mute); }
@media (max-width: 767px) {
  .nx-stage-wrap { display: none; }
  .nx-mobile-grid { display: grid; }
  .nx-nav nav { gap: 12px; }
  .nx-nav .nx-btn { padding: 8px 12px; font-size: 14px; }
  .nx-hero-cta { flex-wrap: wrap; }
  .nx-detail-card { grid-template-columns: 1fr; padding: 20px; }
  .nx-plans-grid { grid-template-columns: 1fr; }
}

@keyframes nx-spin { to { transform: rotate(360deg); } }
@keyframes nx-flow { to { stroke-dashoffset: -2.8; } }
@keyframes nx-blink { 50% { opacity: 0.45; } }
@keyframes nx-breathe { 50% { transform: scale(1.08); opacity: 0.8; } }
@keyframes nx-fade { from { opacity: 0; } }
@keyframes nx-rise { from { opacity: 0; transform: translateY(30px) scale(0.96); } }
@keyframes nx-sheen { to { top: 100%; } }
@keyframes nx-float { 50% { transform: translateY(-7px); } }
@keyframes nx-materialize { from { opacity: 0; transform: translateY(40px); filter: brightness(2.2) blur(3px); } }
@keyframes nx-flash { 0% { opacity: 0; } 55% { opacity: 1; } 100% { opacity: 0; } }
@keyframes nx-burst { 0% { box-shadow: 0 0 0 0 rgba(140, 230, 255, 0.9); } 100% { box-shadow: 0 0 0 40px rgba(140, 230, 255, 0); } }
@keyframes nx-grow { from { transform: scaleY(0); } }
@keyframes nx-arc { to { stroke-dashoffset: 30; } }
@keyframes nx-needle { from { transform: rotate(-75deg); } to { transform: rotate(35deg); } }
@keyframes nx-ping { from { transform: scale(1); opacity: 0.9; } to { transform: scale(7); opacity: 0; } }

@media (prefers-reduced-motion: reduce) {
  .nx-root *, .nx-root *::before, .nx-root *::after { animation: none !important; transition-duration: 0.01ms !important; }
}
